<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LiteCast: dark from the first frame so the TV never flashes white -->
    <style name="Theme.LiteCast" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lc_background</item>
        <item name="android:colorBackground">@color/lc_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/lc_background</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="Theme.LiteCast.Player" parent="Theme.LiteCast">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
